+// GH#20936 debug: append one line per TSF event to %TEMP%\wt-tsf-20936.log
+static void tsfLog(const std::string& msg) noexcept
+try
+{
+    static const auto path = [] {
+        wchar_t buf[MAX_PATH];
+        const auto n = GetTempPathW(MAX_PATH, buf);
+        return std::wstring{ buf, n } + L"wt-tsf-20936.log";
+    }();
+    const auto line = fmt::format("{} t={} {}\r\n", GetTickCount64(), GetCurrentThreadId(), msg);
+    wil::unique_hfile f{ CreateFileW(path.c_str(), FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr) };
+    if (f)
+    {
+        DWORD written;
+        WriteFile(f.get(), line.data(), static_cast<DWORD>(line.size()), &written, nullptr);
+    }
+}
+catch (...)
+{
+}
+#define TSFLOG(...) tsfLog(fmt::format(__VA_ARGS__))
+
+// 0 = TSF focus is not on our document manager, 1 = it is, -1 = GetFocus failed
+static int tsfFocusIsOurs(ITfThreadMgrEx* mgr, ITfDocumentMgr* ours) noexcept
+{
+    wil::com_ptr<ITfDocumentMgr> focused;
+    if (FAILED(mgr->GetFocus(focused.addressof())))
+    {
+        return -1;
+    }
+    return focused.get() == ours ? 1 : 0;
+}
