index b9964de..efaf9d7 100644
--- a/src/cascadia/TerminalControl/TermControl.cpp
+++ b/src/cascadia/TerminalControl/TermControl.cpp
@@ -84,7 +84,11 @@ static Microsoft::Console::TSF::Handle& GetTSFHandle()
 {
     // NOTE: If we ever go back to 1 thread per 1 window,
     // you need to swap the `static` with a `thread_local`.
-    static auto s_tsf = ::Microsoft::Console::TSF::Handle::Create();
+    static auto s_tsf = [] {
+        // TF_TMAE_CONSOLE makes Microsoft Bopomofo drop the first key after a reactivation mid-composition, see GH#20936
