+// true if the foreground window belongs to another thread, i.e. our window was deactivated
+static bool tsfWindowDeactivated() noexcept
+{
+    const auto fg = GetForegroundWindow();
+    return !fg || GetWindowThreadProcessId(fg, nullptr) != GetCurrentThreadId();
+}
+
+// mode g: ask the IME to complete its composition via IMM (imm32 is loaded dynamically, TerminalControl doesn't link it)
+static BOOL tsfImmComplete(HWND hwnd) noexcept
+{
+    static const auto imm = LoadLibraryExW(L"imm32.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!imm)
+    {
+        return FALSE;
+    }
+    using GetContext = HIMC(WINAPI*)(HWND);
+    using NotifyIME = BOOL(WINAPI*)(HIMC, DWORD, DWORD, DWORD);
+    using ReleaseContext = BOOL(WINAPI*)(HWND, HIMC);
+    const auto getContext = reinterpret_cast<GetContext>(GetProcAddress(imm, "ImmGetContext"));
+    const auto notifyIME = reinterpret_cast<NotifyIME>(GetProcAddress(imm, "ImmNotifyIME"));
+    const auto releaseContext = reinterpret_cast<ReleaseContext>(GetProcAddress(imm, "ImmReleaseContext"));
+    if (!getContext || !notifyIME || !releaseContext)
+    {
+        return FALSE;
+    }
+    const auto himc = getContext(hwnd);
+    if (!himc)
+    {
+        return FALSE;
+    }
+    const auto ok = notifyIME(himc, NI_COMPOSITIONSTR, CPS_COMPLETE, 0);
+    releaseContext(hwnd, himc);
+    return ok;
+}
+
+// 0 = TSF focus is not on our document manager, 1 = it is, -1 = GetFocus failed
+static int tsfFocusIsOurs(ITfThreadMgrEx* mgr, ITfDocumentMgr* ours) noexcept
+{
+    wil::com_ptr<ITfDocumentMgr> focused;
+    if (FAILED(mgr->GetFocus(focused.addressof())))
+    {
+        return -1;
+    }
+    return focused.get() == ours ? 1 : 0;
+}
